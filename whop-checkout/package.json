{
  "name": "jc-whop-checkout",
  "private": true,
  "description": "Whop embedded checkout for the Curso de Confianza page, bundled with React for plain HTML pages",
  "scripts": {
    "build": "esbuild EmbeddedCheckout.jsx --bundle --minify --format=iife --target=es2019 --define:process.env.NODE_ENV='\"production\"' --jsx=automatic --outfile=../funnel/whop-checkout.js"
  },
  "dependencies": {
    "@whop/elements": "1.9.0",
    "@whop/elements-react": "1.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
